# Generate with: openssl rand -base64 32
CONNKIT_MASTER_KEY=
CONNKIT_ADMIN_USERNAME=admin
# Set an independent password of 12-72 bytes.
CONNKIT_ADMIN_PASSWORD=
CONNKIT_IMAGE_TAG=main
# Optional comma-separated source CIDRs for the anonymous MCP listener.
# Uses the immediate network peer, not client-supplied forwarding headers.
CONNKIT_MCP_TRUSTED_CIDRS=
# Optional exact browser origins; requests with other Origin headers are rejected.
CONNKIT_MCP_ORIGINS=

# Configuration storage: sqlite (default) or postgres. Both processes use the same DSN.
CONNKIT_DB_DRIVER=sqlite
# Dedicated PostgreSQL database/role; percent-encode special URL password characters.
# CONNKIT_DB_DSN=postgres://connkit:replace-me@postgres:5432/connkit?sslmode=verify-full
# Optional immutable image references override CONNKIT_IMAGE_TAG.
# CONNKIT_ADMIN_IMAGE=ghcr.io/nathan77886/connkit-admin@sha256:...
# CONNKIT_MCP_IMAGE=ghcr.io/nathan77886/connkit-mcp@sha256:...
